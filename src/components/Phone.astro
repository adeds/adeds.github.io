---
/**
 * Sticky device mockup. Each <section.screen> mirrors one page section and is
 * activated by scroll (see scripts/app.ts). Purely decorative: the real
 * content lives in the page, so the whole device is aria-hidden by the parent.
 */
import { Picture } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import photo from '../assets/ade-at-work.webp';
import { site } from '../site.config';
import { formatDate } from '../lib/format';

interface Props {
  experience: CollectionEntry<'experience'>[];
  projects: CollectionEntry<'projects'>[];
  writing: CollectionEntry<'writing'>[];
  skills: CollectionEntry<'skills'>[];
}
const { experience, projects, writing, skills } = Astro.props;
const main = experience[0].data;
const earlier = experience.slice(1);
const today = new Date();
const dateLabel = today.toLocaleDateString('en-US', { weekday: 'long', month: 'long', day: 'numeric', timeZone: 'Asia/Jakarta' });
---
<div class="phone" data-phone>
  <div class="phone__frame" data-tilt>
    <div class="phone__screen">
      <div class="phone__wallpaper" data-tilt-layer>
        <span class="blob blob--a"></span>
        <span class="blob blob--b"></span>
        <span class="blob blob--c"></span>
      </div>

      <div class="phone__status">
        <span class="phone__time" data-clock>9:41</span>
        <span class="phone__cutout"></span>
        <span class="phone__icons">
          <svg width="17" height="11" viewBox="0 0 17 11"><rect x="0" y="7" width="3" height="4" rx="1"/><rect x="4.5" y="5" width="3" height="6" rx="1"/><rect x="9" y="2.5" width="3" height="8.5" rx="1"/><rect x="13.5" y="0" width="3" height="11" rx="1"/></svg>
          <svg width="15" height="11" viewBox="0 0 15 11"><path d="M7.5 2.2c2.2 0 4.2.9 5.7 2.3l1.1-1.1A9.6 9.6 0 0 0 7.5.6 9.6 9.6 0 0 0 .7 3.4l1.1 1.1a8 8 0 0 1 5.7-2.3zm0 3.2c1.3 0 2.5.5 3.4 1.3l1.1-1.1a6.4 6.4 0 0 0-9 0l1.1 1.1c.9-.8 2.1-1.3 3.4-1.3zm0 3.2c.5 0 .9.2 1.2.5L7.5 10.3 6.3 9.1c.3-.3.7-.5 1.2-.5z"/></svg>
          <span class="battery"><span></span></span>
        </span>
      </div>

      <!-- Lock screen -->
      <section class="screen screen--lock is-active" data-screen="hero">
        <p class="lock__date">{dateLabel}</p>
        <p class="lock__time" data-clock-big>9:41</p>
        <div class="notif">
          <div class="notif__icon">AD</div>
          <div class="notif__body">
            <p class="notif__meta"><span>Portfolio</span><span>now</span></p>
            <p class="notif__title">{site.name}</p>
            <p class="notif__text">{site.headline}, {site.platforms}. Scroll to open.</p>
          </div>
        </div>
      </section>

      <!-- Profile -->
      <section class="screen" data-screen="about">
        <header class="appbar"><span class="appbar__title">Profile</span></header>
        <div class="screen__body">
          <div class="profile">
            <Picture src={photo} alt="" widths={[160]} sizes="80px" formats={['avif', 'webp']} fallbackFormat="jpg" class="profile__photo" />
            <p class="profile__name">{site.name}</p>
            <p class="profile__role">{site.headline} · {site.platforms}</p>
          </div>
          <div class="tiles">
            {site.stats.map((s) => (
              <div class="tile"><span class="tile__value">{s.value}</span><span class="tile__label">{s.label}</span></div>
            ))}
          </div>
        </div>
      </section>

      <!-- Work -->
      <section class="screen" data-screen="work">
        <header class="appbar"><span class="appbar__title">Work</span></header>
        <div class="screen__body">
          <p class="group-label">Now</p>
          <div class="list">
            <div class="row row--tall">
              <span class="row__icon">S</span>
              <span class="row__text"><b>{main.company}</b><small>{main.role}</small></span>
            </div>
            {main.tracks?.map((t) => (
              <div class="row">
                <span class={`dot dot--${t.platform}`}></span>
                <span class="row__text"><b>{t.label}</b><small>since {t.since.slice(0, 4)}</small></span>
              </div>
            ))}
          </div>
          <p class="group-label">Before</p>
          <div class="list">
            {earlier.map((e) => (
              <div class="row">
                <span class="row__text"><b>{e.data.company}</b><small>{e.data.role} · {e.data.start.slice(0, 4)}</small></span>
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- Projects -->
      <section class="screen" data-screen="projects">
        <header class="appbar"><span class="appbar__title">Projects</span></header>
        <div class="screen__body">
          {projects.map((p) => (
            <div class="store-row">
              <span class={`app-icon app-icon--${p.data.platform}`}>{p.data.name.charAt(0)}</span>
              <span class="row__text"><b>{p.data.name}</b><small>{p.data.stack.slice(0, 2).join(' · ')}</small></span>
              <span class="get-btn"><span class="get-btn__ios">View</span><span class="get-btn__android">Open</span></span>
            </div>
          ))}
        </div>
      </section>

      <!-- Writing -->
      <section class="screen" data-screen="writing">
        <header class="appbar"><span class="appbar__title">Reading list</span></header>
        <div class="screen__body">
          <div class="list">
            {writing.map((w) => (
              <div class="row row--tall">
                <span class="row__text"><b>{w.data.title}</b><small>{w.data.publication} · {formatDate(w.data.date)}</small></span>
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- Skills -->
      <section class="screen" data-screen="skills">
        <header class="appbar"><span class="appbar__title">Skills</span></header>
        <div class="screen__body">
          {skills.slice(0, 4).map((g) => (
            <>
              <p class="group-label">{g.data.label}</p>
              <div class="mini-chips">{g.data.items.slice(0, 5).map((i) => <span>{i}</span>)}</div>
            </>
          ))}
        </div>
      </section>

      <!-- Contact -->
      <section class="screen" data-screen="contact">
        <header class="appbar"><span class="appbar__title">New message</span></header>
        <div class="screen__body">
          <div class="compose">
            <p class="compose__field"><span>To</span><b>{site.name}</b></p>
            <p class="compose__field"><span>Subject</span><b>Let's talk</b></p>
            <p class="compose__text">Hi Ade, I saw your portfolio and…<span class="caret"></span></p>
          </div>
          <span class="send-btn"><svg viewBox="0 0 24 24" width="20" height="20"><path d="M12 19V5M5 12l7-7 7 7" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
        </div>
      </section>

      <span class="phone__home"></span>
    </div>
  </div>
</div>
